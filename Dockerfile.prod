# =============================================================================
# Production Dockerfile for Blog AI SaaS Application
# Multi-stage build for minimal image size and security
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Backend Dependencies Builder
# -----------------------------------------------------------------------------
FROM python:3.12-slim AS backend-deps

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.10.0 /uv /uvx /bin/

# uv builds the production venv at /opt/venv from the lockfile. The venv
# contains no pip at all — the runtime never installs packages, and pip's
# vendored copies of msgpack/setuptools carry CVEs (flagged by Trivy under
# the "Python" target) that even the newest pip still ships.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1

COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv sync --locked --no-dev

FROM oven/bun:1.3.10 AS bun-runtime

# -----------------------------------------------------------------------------
# Stage 2: Frontend Builder
# -----------------------------------------------------------------------------
FROM oven/bun:1.3.10 AS frontend-builder

WORKDIR /build

# Install dependencies first (better layer caching)
COPY package.json bun.lock bunfig.toml ./
COPY apps/web/package.json ./apps/web/package.json

# Use Bun's lockfile for reproducible builds
RUN bun install --frozen-lockfile

# Copy all frontend source files
COPY apps/web/ ./apps/web/

# Set production environment for build optimization
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Build the Next.js application
RUN bun run build

# -----------------------------------------------------------------------------
# Stage 3: Frontend Runtime Dependencies
# -----------------------------------------------------------------------------
FROM oven/bun:1.3.10 AS frontend-runtime-deps

WORKDIR /build

COPY package.json bun.lock bunfig.toml ./
COPY apps/web/package.json ./apps/web/package.json

RUN bun install --frozen-lockfile --production

# -----------------------------------------------------------------------------
# Stage 4: Production Runtime
# -----------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

# Build arguments for versioning
ARG BUILD_DATE
ARG GIT_SHA
ARG VERSION=1.0.0

# Labels for container metadata
LABEL org.opencontainers.image.title="Blog AI" \
      org.opencontainers.image.description="AI-powered content generation SaaS" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.vendor="Blog AI" \
      org.opencontainers.image.licenses="MIT"

# Create non-root user for security
RUN groupadd --system --gid 1001 blogai && \
    useradd --system --uid 1001 --gid blogai --shell /bin/false blogai

WORKDIR /app

# Install runtime dependencies only. Apply available base-image security
# updates first (e.g. openssl/libssl3 CVE fixes) so the published image picks
# up patched system packages rather than shipping the base image's snapshot.
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
    curl \
    nodejs \
    tini \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Drop the base image's own pip too — nothing installs packages at runtime,
# and every pip release vendors msgpack/setuptools copies with known CVEs.
RUN python -m pip uninstall -y pip

# Copy virtual environment from builder
COPY --from=backend-deps /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy backend application code
COPY --chown=blogai:blogai apps/api/src/ ./src/
COPY --chown=blogai:blogai apps/api/app/ ./app/
COPY --chown=blogai:blogai apps/api/server.py ./

# Copy frontend build artifacts
COPY --from=frontend-builder --chown=blogai:blogai /build/apps/web/.next ./.next
COPY --from=frontend-builder --chown=blogai:blogai /build/apps/web/public ./public
COPY --from=frontend-runtime-deps --chown=blogai:blogai /build/node_modules ./node_modules
COPY --from=frontend-builder --chown=blogai:blogai /build/apps/web/package.json ./package.json
COPY --from=frontend-builder --chown=blogai:blogai /build/apps/web/next.config.mjs ./next.config.mjs
COPY --from=frontend-builder --chown=blogai:blogai /build/bunfig.toml ./bunfig.toml
COPY --from=bun-runtime --chown=blogai:blogai /usr/local/bin/bun /usr/local/bin/bun

RUN ln -sf /usr/local/bin/bun /usr/local/bin/bunx

# Create startup script with proper signal handling
RUN cat > /app/entrypoint.sh << 'EOF'
#!/bin/bash
set -e

# Trap SIGTERM and SIGINT for graceful shutdown
_term() {
    echo "Caught SIGTERM signal, shutting down gracefully..."
    kill -TERM "$BACKEND_PID" 2>/dev/null
    kill -TERM "$FRONTEND_PID" 2>/dev/null
    wait "$BACKEND_PID" "$FRONTEND_PID"
    exit 0
}

trap _term SIGTERM SIGINT

# Start backend server
echo "Starting backend server on port ${BACKEND_PORT:-8000}..."
python -m uvicorn server:app \
    --host 0.0.0.0 \
    --port ${BACKEND_PORT:-8000} \
    --workers ${UVICORN_WORKERS:-1} \
    --loop uvloop \
    --no-access-log &
BACKEND_PID=$!

# Start frontend server
echo "Starting frontend server on port ${FRONTEND_PORT:-3000}..."
cd /app
NODE_ENV=production bun run start -- --hostname 0.0.0.0 --port ${FRONTEND_PORT:-3000} &
FRONTEND_PID=$!

# Wait for both processes
wait "$BACKEND_PID" "$FRONTEND_PID"
EOF

RUN chmod +x /app/entrypoint.sh

# Set environment variables
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    # Default ports
    BACKEND_PORT=8000 \
    FRONTEND_PORT=3000 \
    # Default worker count (can be overridden)
    UVICORN_WORKERS=1

# Expose ports
EXPOSE 8000 3000

# Health check for both services
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${BACKEND_PORT:-8000}/health || exit 1

# Switch to non-root user
USER blogai

# Use tini as init system for proper signal handling
ENTRYPOINT ["/usr/bin/tini", "--"]

# Start the application
CMD ["/app/entrypoint.sh"]
