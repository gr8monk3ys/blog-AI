# =============================================================================
# Blog AI web app (apps/web) environment
# =============================================================================
# Copy to apps/web/.env.local and fill in. NEVER commit .env.local.
#
# NEXT_PUBLIC_* values are inlined into the bundle at BUILD time: set them for
# `bun run build` (and in every Vercel environment), not only for `start`.
# Full reference with required/optional per process: docs/ENVIRONMENT.md, or
# `bun run env:check`. Audit a pulled file: `bun run env:check -- --check <file>`.

# =============================================================================
# Backend API
# =============================================================================

# FastAPI base URL (protocol, no trailing slash). REQUIRED.
# Production: https://blog-ai-api-gr8monk3ys-projects.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket base. Optional: derived from NEXT_PUBLIC_API_URL (http->ws, https->wss).
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# API path version segment (default v1).
# NEXT_PUBLIC_API_VERSION=v1

# Local-only API key fallback when Clerk is absent. Never set in production.
# NEXT_PUBLIC_API_KEY=your_dev_api_key

# =============================================================================
# Site identity
# =============================================================================

# Public origin for the sitemap, RSS, metadataBase and Sentry allowUrls.
# Production: https://blog-ai.vivancedata.com (also the fallback on a Vercel
# production build; previews fall back to https://$VERCEL_URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Support inbox shown on the error, 404 and pricing pages. Must be an address
# someone reads. Default: support@lscaturchio.xyz (apps/web/lib/support.ts).
# NEXT_PUBLIC_SUPPORT_EMAIL=support@lscaturchio.xyz

# Version string /api/health reports (default: apps/web/package.json version).
# NEXT_PUBLIC_APP_VERSION=

# =============================================================================
# Clerk authentication
# =============================================================================
# Optional in development: with no publishable key every route is public.
# Both keys are REQUIRED for a production build (next.config.mjs enforces it).

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Clerk custom domain (production: clerk.vivancedata.com). Added to the CSP.
# NEXT_PUBLIC_CLERK_DOMAIN=clerk.vivancedata.com

# =============================================================================
# Sign-up gating and feature flags (apps/web/lib/signup-mode.ts, lib/features.ts)
# =============================================================================
# Flags accept true/false (also 1/0, on/off, yes/no). A flag says "we promise
# this"; the matching API key makes it true. Set both or neither.

# open | waitlist | invite. Must match the Clerk dashboard sign-up mode. Default open.
# NEXT_PUBLIC_SIGNUP_MODE=open

# Knowledge base (/knowledge + nav link). Pair with ENABLE_KNOWLEDGE_BASE on the API.
NEXT_PUBLIC_ENABLE_KNOWLEDGE_BASE=false

# Advertise Gemini as a provider. Pair with GEMINI_API_KEY on the API.
# NEXT_PUBLIC_LLM_GEMINI=false

# Research mode, fact-check sources, SERP analysis. Pair with SERP/Tavily/Metaphor keys.
# NEXT_PUBLIC_FEATURE_WEB_RESEARCH=false

# /images. Pair with IMAGE_PROVIDER and an OpenAI or Stability key.
# NEXT_PUBLIC_FEATURE_IMAGE_GENERATION=false

# /plagiarism. Pair with Copyscape or Originality credentials.
# NEXT_PUBLIC_FEATURE_PLAGIARISM_CHECK=false

# /social. Pair with Twitter/LinkedIn OAuth or BUFFER_ACCESS_TOKEN.
# NEXT_PUBLIC_FEATURE_SOCIAL_POSTING=false

# /team organisations and invites (no mailer delivers invites yet).
# NEXT_PUBLIC_FEATURE_TEAMS=false

# Pricing, checkout, billing portal. Default ON (Stripe is live). false hides them.
# NEXT_PUBLIC_FEATURE_BILLING=true

# =============================================================================
# Database (Neon Postgres) -- server-side route handlers only
# =============================================================================
# Templates, brand profiles, history, blog CMS. Without it they fall back to memory.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Protects /api/blog-posts/* (x-admin-key header or Bearer). Unset: those routes are closed.
# BLOG_ADMIN_KEY=

# Unlocks the `details` block of GET /api/health (`Authorization: Bearer <token>`):
# which Clerk key is missing, database/API error text, the API's services summary.
# The public response is aggregate only. Unset: no detail view exists.
# HEALTH_DETAIL_TOKEN=

# Seed demo data outside production (lib/server-mode.ts).
# DEMO_DATA_ENABLED=true

# =============================================================================
# Sentry (optional)
# =============================================================================
# Sentry only initialises on a Vercel deployment (VERCEL_ENV=production|preview).
# A DSN here does NOT make a local run report -- deliberate: every project in
# the org shares one error quota and local noise exhausted it once already.
# See docs/MONITORING.md and apps/web/lib/sentry-env.ts.

# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Source-map upload at build time (all three needed; otherwise skipped).
# SENTRY_ORG=your-org
# SENTRY_PROJECT=blog-ai
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Report from a local BUILD on purpose (use a throwaway DSN):
# NEXT_PUBLIC_SENTRY_FORCE_ENABLE=1
# Kill switch for a deployed build:
# NEXT_PUBLIC_SENTRY_FORCE_DISABLE=1

# =============================================================================
# Not here on purpose
# =============================================================================
# Stripe keys (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID_*) are
# read by the API only: put them in the root .env (see .env.example). The web
# app has no Stripe.js, so there is no NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY.
# Clerk's NEXT_PUBLIC_CLERK_SIGN_IN_URL / _SIGN_UP_URL / _AFTER_* are not read
# by this codebase (the pages are /sign-in and /sign-up and redirects are set in
# code); setting them does nothing.
