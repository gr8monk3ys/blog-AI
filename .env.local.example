# =============================================================================
# Blog AI Frontend Environment Configuration
# =============================================================================
# Copy this file to .env.local and update the values
# NEVER commit .env.local to version control

# =============================================================================
# Backend API Configuration
# =============================================================================

# Backend API URL (include protocol, no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL (use ws:// for local dev, wss:// for production)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# API Key for authentication (optional in dev mode)
# NEXT_PUBLIC_API_KEY=your_api_key_here

# =============================================================================
# Clerk Authentication (Recommended)
# =============================================================================
# Get these from your Clerk dashboard

# Public key used by the browser
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Secret key used on the server (Next.js route handlers)
CLERK_SECRET_KEY=sk_test_your_secret_key

# Optional: default auth routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# =============================================================================
# Database (Neon Postgres)
# =============================================================================
# Used by Next.js route handlers (templates, brand profiles, history, blog CMS).
# For Neon, copy the connection string from the Neon console.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# =============================================================================
# Sentry Error Tracking (Optional)
# =============================================================================
# Get these from your Sentry project: https://sentry.io

# Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Sentry organization and project (for source map uploads)
# SENTRY_ORG=your-org
# SENTRY_PROJECT=blog-ai

# Sentry auth token (for uploading source maps in CI/CD)
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Sentry only initialises on a Vercel deployment (VERCEL_ENV=production|preview).
# A DSN here does NOT make a local run report -- that is deliberate: all projects
# in the org share one error quota and local noise exhausted it once already.
# See docs/MONITORING.md and apps/web/lib/sentry-env.ts.
#
# To deliberately report from a local build (use a throwaway DSN), set this for
# the BUILD, not just `start`: it is inlined at build time.
# NEXT_PUBLIC_SENTRY_FORCE_ENABLE=1
#
# Kill switch: stops a deployed build from reporting.
# NEXT_PUBLIC_SENTRY_FORCE_DISABLE=1

# =============================================================================
# Stripe Payment Configuration (Optional for local dev)
# =============================================================================
# Get test keys from: https://dashboard.stripe.com/test/apikeys
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
