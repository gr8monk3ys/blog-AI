{
  "buildCommand": "BROWSERSLIST_IGNORE_OLD_DATA=1 bun run build",
  "installCommand": "rm -rf node_modules apps/web/node_modules && bun install --frozen-lockfile",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "functions": {
    "api/backend.py": {
      "maxDuration": 300,
      "includeFiles": "apps/api/**",
      "excludeFiles": "{node_modules/**,apps/web/**,apps/extension/**,docs/**,content/**,db/**,scripts/**,.github/**,.worktrees/**,apps/api/tests/**,apps/api/data/**,apps/api/migrations/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
